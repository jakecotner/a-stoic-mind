# Optional. In dev the app derives the backend address from the Metro host
# (your computer's LAN IP) plus BACKEND_PORT in src/lib/api.ts — leave this
# unset. Set it (in .env, or as an EAS build env var) for preview/production
# builds that talk to a deployed backend.
# EXPO_PUBLIC_API_URL=https://your-deployed-backend.example.com
