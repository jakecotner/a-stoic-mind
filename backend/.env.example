# Copy to .env and fill in. All values shown are the defaults.

DATABASE_URL=postgresql+psycopg://astoicmind:astoicmind@localhost:5432/astoicmind

# Required for the /api/chat endpoint
# ANTHROPIC_API_KEY=sk-ant-...

ANTHROPIC_MODEL=claude-opus-4-8
CHAT_EFFORT=medium

# Auth: signs JWT session cookies. Generate a real one for any shared deployment,
# e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=dev-only-change-me
# Set true when serving over HTTPS so the session cookie is Secure.
AUTH_COOKIE_SECURE=false

# Email verification. On: new accounts get a verification email, and chat
# turns / checkout require a verified address (sign-in still works — the
# frontend shows a verify banner). Off: registration is frictionless.
REQUIRE_EMAIL_VERIFICATION=false

# Stripe — all unset means payments are dark (checkout/portal return 503).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ANNUAL=price_...
# STRIPE_PRICE_MONTHLY=price_...

# Transactional email (password resets). Unset: emails are logged, not sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=A Stoic Mind <hello@example.com>

# Production only:
# PUBLIC_BASE_URL=https://example.com
# SENTRY_DSN=https://...
